# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ---- WhatsApp / Dualhook (fill after Dualhook onboarding) ----
WA_API_HOST=https://api.dualhook.com   # outbound sends go through the Dualhook relay
WHATSAPP_TOKEN=              # Dualhook dh_live_ key (NOT the Meta System User token)
WHATSAPP_PHONE_NUMBER_ID=    # from Dualhook / WhatsApp API setup
META_APP_SECRET=             # App > Settings > Basic (leave blank to skip sig check while testing)
META_VERIFY_TOKEN=           # invent any random string; paste the SAME value into Dualhook
GRAPH_VERSION=v25.0

# ---- Bot ----
PORT=3000
BUSINESS_WA_NUMBER=524427041833   # the shop's own WhatsApp number; messages FROM it are staff, never customers
ESCALATION_WINDOW_MS=3600000      # how long the bot stays quiet after staff reply / handoff (1h)
FIRST_REPLY_DELAY_MS=300000       # hold the first reply on a new thread so staff can answer first (5 min; 0 = instant)
CONVO_STORE_PATH=/data/conversations.json   # Railway VOLUME path
